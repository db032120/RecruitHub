<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Job_Must_Be_Open</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), TEXT(Job_Posting__r.Status__c) &lt;&gt; &quot;Open&quot;)</errorConditionFormula>
    <errorDisplayField>Job_Posting__c</errorDisplayField>
    <errorMessage>This job isn&apos;t accepting applications.</errorMessage>
</ValidationRule>
